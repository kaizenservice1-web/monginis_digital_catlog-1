{
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/catalog", "destination": "/catalog.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/social", "destination": "/social.html" },
    { "source": "/cake-details", "destination": "/cake-details.html" },
    { "source": "/pages/admin-login", "destination": "/pages/admin-login.html" },
    { "source": "/pages/admin-dashboard", "destination": "/pages/admin-dashboard.html" },
    { "source": "/pages/employee-login", "destination": "/pages/employee-login.html" },
    { "source": "/pages/employee-select", "destination": "/pages/employee-select.html" },
    { "source": "/pages/employee-dashboard", "destination": "/pages/employee-dashboard.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}