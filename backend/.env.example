PORT=3000
MONGODB_URI=your_mongodb_atlas_uri
JWT_SECRET=change_me
FRONTEND_ORIGIN=http://localhost:5173

#
# Set temporarily to true when rotating an existing seeded account password.
AUTH_FORCE_RESET=false
# Legacy owner variables remain supported:
# ADMIN_EMAIL=owner@monginis.com
# ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
